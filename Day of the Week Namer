
#include <stdio.h>

void dayNamer(int num){

 switch(num){
        case 1:
        printf("Monday");

        case 2:
        printf("Tuesday");

        case 3:
        printf("Wednesday");

        case 4:
        printf("Thursday");

        case 5:
        printf("Friday");

        case 6:
        printf("Saturday");

        case 7:
        printf("Sunday");
    }
}


int main() {

    int num;
    
    
    printf("Enter a number(1-7): ");
    scanf("%d",&num);

    
    printf("Day %d is ",num);
    dayNamer(num);
    

    return 0;
}
